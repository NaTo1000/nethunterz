<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>JessicAi Medusa</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>JessicAi Medusa Cyberstack requires Bluetooth to discover and communicate with Flipper Zero devices, NRF modules, and ESP32 boards in your LoRa mesh network.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>JessicAi Medusa Cyberstack requires Bluetooth to connect to BLE-enabled security hardware.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to securely authenticate and access JessicAi Medusa Cyberstack.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>JessicAi Medusa Cyberstack requires continuous location access to monitor geofences and trigger defensive responses when devices enter or exit secure perimeters.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>JessicAi Medusa Cyberstack requires location access in the background for geofence monitoring and mesh node positioning.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>JessicAi Medusa Cyberstack uses your location to display LoRa node positions and manage geofence zones on the map.</string>
    <key>NSMotionUsageDescription</key>
    <string>Motion data may be used to improve mesh network positioning accuracy.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>MinimumOSVersion</key>
    <string>16.0</string>
    <key>NSCameraUsageDescription</key>
    <string>Camera access may be used for QR code scanning to pair with mesh devices.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>JessicAi Medusa Cyberstack uses the local network to communicate with ESP32 devices and LoRa mesh gateways over Wi-Fi.</string>
</dict>
</plist>

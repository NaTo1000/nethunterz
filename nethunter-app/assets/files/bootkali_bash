# NetHunter Kali chroot bash profile
# Sourced when an interactive shell is opened inside the chroot

export TERM=xterm-256color
export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/bash
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DISPLAY=:0
export PULSE_SERVER=127.0.0.1

# Kali colour prompt
if [ "$(id -u)" -eq 0 ]; then
    PS1='\[\033[01;31m\]\u@nethunter\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='\[\033[01;32m\]\u@nethunter\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
fi

# Handy aliases
alias ll='ls -la --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias update='apt-get update && apt-get upgrade -y'
alias msfconsole='msfconsole -q'

# Load system-wide profile if present
if [ -f /etc/profile ]; then
    . /etc/profile
fi

echo ""
echo " ┌──────────────────────────────────────┐"
echo " │  NetHunter Kali Linux Chroot Shell   │"
echo " │  Type 'exit' to leave the chroot     │"
echo " └──────────────────────────────────────┘"
echo ""

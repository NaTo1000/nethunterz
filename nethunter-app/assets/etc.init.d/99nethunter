#!/bin/sh
### BEGIN INIT INFO
# Provides:          nethunter
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NetHunter services
# Description:       Start/stop NetHunter security services inside the chroot
### END INIT INFO

NETHUNTER_HOME="/root"
LOG="/var/log/nethunter-init.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"
}

start() {
    log "Starting NetHunter init.d services..."
    if [ -x /usr/bin/dbus-daemon ]; then
        if ! pgrep -x dbus-daemon > /dev/null 2>&1; then
            mkdir -p /var/run/dbus
            dbus-uuidgen > /var/lib/dbus/machine-id 2>/dev/null
            dbus-daemon --system --fork
            log "D-Bus daemon started"
        fi
    fi
    if [ -f /etc/ssh/sshd_config ]; then
        mkdir -p /var/run/sshd
        /usr/sbin/sshd && log "SSHd started" || log "SSHd start failed"
    fi
    log "NetHunter services started"
}

stop() {
    log "Stopping NetHunter services..."
    SSHD_PID=$(pgrep -x sshd 2>/dev/null | head -1)
    [ -n "$SSHD_PID" ] && kill "$SSHD_PID" 2>/dev/null
    DBUS_PID=$(pgrep -x dbus-daemon 2>/dev/null | head -1)
    [ -n "$DBUS_PID" ] && kill "$DBUS_PID" 2>/dev/null
    log "NetHunter services stopped"
}

status() {
    echo "=== NetHunter Service Status ==="
    pgrep -x sshd > /dev/null 2>&1 && echo "sshd: RUNNING" || echo "sshd: STOPPED"
    pgrep -x dbus-daemon > /dev/null 2>&1 && echo "dbus: RUNNING" || echo "dbus: STOPPED"
}

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) stop; start ;;
    status)  status  ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
exit 0

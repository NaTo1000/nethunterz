#!/system/bin/sh
# bootkali - Boot the Kali NetHunter chroot environment
# Place in /system/bin/ or execute directly

NH_DIR=/data/local/nhsystem
KALI_DIR=$NH_DIR/kali-arm64
KALI_LAUNCHER=$KALI_DIR/scripts/kali

# Colors for terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info()  { echo "${GREEN}[+]${NC} $1"; }
log_warn()  { echo "${YELLOW}[!]${NC} $1"; }
log_error() { echo "${RED}[-]${NC} $1"; }

# Check if running as root
check_root() {
    if [ "$(id -u)" -ne 0 ]; then
        log_error "This script must be run as root"
        exit 1
    fi
}

# Check if chroot directory exists
check_chroot() {
    if [ ! -d "$KALI_DIR" ]; then
        log_error "Kali chroot not found at $KALI_DIR"
        log_info "Please install NetHunter chroot first"
        exit 1
    fi
}

# Mount required filesystems
mount_filesystems() {
    log_info "Mounting filesystems..."

    # Mount /proc if not already mounted
    if ! mountpoint -q "$KALI_DIR/proc" 2>/dev/null; then
        mount -t proc proc "$KALI_DIR/proc"
        log_info "Mounted /proc"
    fi

    # Mount /sys if not already mounted
    if ! mountpoint -q "$KALI_DIR/sys" 2>/dev/null; then
        mount -t sysfs sysfs "$KALI_DIR/sys"
        log_info "Mounted /sys"
    fi

    # Mount /dev if not already mounted
    if ! mountpoint -q "$KALI_DIR/dev" 2>/dev/null; then
        mount -o bind /dev "$KALI_DIR/dev"
        log_info "Mounted /dev"
    fi

    # Mount devpts for pseudo-terminals
    if ! mountpoint -q "$KALI_DIR/dev/pts" 2>/dev/null; then
        mkdir -p "$KALI_DIR/dev/pts"
        mount -t devpts devpts "$KALI_DIR/dev/pts"
        log_info "Mounted /dev/pts"
    fi

    # Mount /sdcard for file access
    if [ -d /sdcard ] && ! mountpoint -q "$KALI_DIR/sdcard" 2>/dev/null; then
        mkdir -p "$KALI_DIR/sdcard"
        mount -o bind /sdcard "$KALI_DIR/sdcard"
        log_info "Mounted /sdcard"
    fi
}

# Configure DNS
setup_dns() {
    if [ ! -f "$KALI_DIR/etc/resolv.conf" ]; then
        echo "nameserver 8.8.8.8" > "$KALI_DIR/etc/resolv.conf"
        echo "nameserver 8.8.4.4" >> "$KALI_DIR/etc/resolv.conf"
        log_info "Configured DNS"
    fi
}

# Start the chroot environment
start_chroot() {
    log_info "Starting Kali chroot environment..."
    setup_dns

    if [ -n "$1" ]; then
        # Execute a specific command
        chroot "$KALI_DIR" /bin/bash -c "$1"
    else
        # Interactive shell
        chroot "$KALI_DIR" /bin/bash --login
    fi
}

# Stop the chroot (unmount everything)
stop_chroot() {
    log_info "Stopping Kali chroot..."

    # Kill processes using the chroot
    fuser -k "$KALI_DIR" 2>/dev/null

    # Unmount in reverse order
    for mount_point in sdcard dev/pts dev sys proc; do
        if mountpoint -q "$KALI_DIR/$mount_point" 2>/dev/null; then
            umount -l "$KALI_DIR/$mount_point" 2>/dev/null && \
                log_info "Unmounted $mount_point"
        fi
    done

    log_info "Chroot stopped"
}

# Main
check_root
check_chroot

case "$1" in
    stop)
        stop_chroot
        ;;
    status)
        if mountpoint -q "$KALI_DIR/proc" 2>/dev/null; then
            log_info "Kali chroot is running"
            exit 0
        else
            log_warn "Kali chroot is not running"
            exit 1
        fi
        ;;
    -c)
        mount_filesystems
        start_chroot "$2"
        ;;
    *)
        mount_filesystems
        start_chroot
        ;;
esac
